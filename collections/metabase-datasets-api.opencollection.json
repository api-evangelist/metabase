{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metabase Cards Datasets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute an ad-hoc query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-metabase-instance.com/api/dataset",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute an ad-hoc query"
        }
      ]
    }
  ],
  "bundled": true
}