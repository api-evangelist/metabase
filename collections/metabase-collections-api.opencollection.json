{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metabase Cards Collections API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-metabase-instance.com/api/collection"
          },
          "docs": "List collections"
        },
        {
          "info": {
            "name": "Create a collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-metabase-instance.com/api/collection",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a collection"
        },
        {
          "info": {
            "name": "Get a collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-metabase-instance.com/api/collection/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a collection"
        }
      ]
    }
  ],
  "bundled": true
}