{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metabase Cards Databases API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Databases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List databases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-metabase-instance.com/api/database"
          },
          "docs": "List databases"
        },
        {
          "info": {
            "name": "Add a database connection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-metabase-instance.com/api/database",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a database connection"
        },
        {
          "info": {
            "name": "Get a database",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-metabase-instance.com/api/database/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a database"
        }
      ]
    }
  ],
  "bundled": true
}