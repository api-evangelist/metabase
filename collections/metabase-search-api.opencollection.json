{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metabase Cards Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Metabase content",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-metabase-instance.com/api/search",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search term."
              }
            ]
          },
          "docs": "Search Metabase content"
        }
      ]
    }
  ],
  "bundled": true
}