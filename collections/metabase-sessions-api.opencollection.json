{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metabase Cards Sessions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-metabase-instance.com/api/session",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticate using username and password to obtain a session ID."
        },
        {
          "info": {
            "name": "Delete a session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://your-metabase-instance.com/api/session"
          },
          "docs": "Sign out the current session."
        }
      ]
    }
  ],
  "bundled": true
}